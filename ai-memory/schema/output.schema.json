{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ceobe.local/schema/ceobe.timeline-summaries/1.0.0",
  "title": "CEOBE AI memory output record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "summary", "tags", "status", "source", "generator", "generated_at"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "maxLength": 160 },
    "tags": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 16 }
    },
    "status": { "enum": ["fresh", "failed"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_message_id", "source_hash"],
      "properties": {
        "last_message_id": { "type": "string", "minLength": 1 },
        "source_hash": { "type": "string", "minLength": 1 }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "prompt_version", "run_id"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "error": { "type": ["string", "null"] }
  }
}
